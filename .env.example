# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pitutor?schema=public"

# Auth.js
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage
# Jika ketiganya diisi, /api/upload akan upload ke Supabase Storage.
# Jika kosong, /api/upload fallback ke public/uploads untuk local development.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="pitutor-uploads"
